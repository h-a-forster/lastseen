# Copy to .env (never commit .env).

# Meta Model API key (dev.meta.ai). Without it, everything runs from cached answers or without model calls.
MODEL_API_KEY=

# Stop a process after it has spent this much (USD) on model calls.
USD_CAP=2
# live = call the API on a cache miss; replay = cached answers only, no network.
MODEL_MODE=live

# The server's paid endpoints (photo check, brief, transcription) stay off unless this is 1.
LIVE_MODELS=0
