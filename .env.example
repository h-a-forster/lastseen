# Copy to .env (never commit .env). Each teammate uses their OWN key and credits.
# Meta credits: $150 per participant on dev.meta.ai. Set a spend-limit alert in Billing.

# Which model the app calls. "mock" works with no key.
# Meta Model API: meta/muse-spark-1.3 (see https://dev.meta.ai/docs/models)
MODEL=mock

MODEL_API_KEY=

# Hard stop after this many model calls per server run (protects credits)
MAX_LLM_CALLS=500

# app/meta_api.py: stop a process after spending this much (USD); replay = cached answers only, no network
USD_CAP=2
MODEL_MODE=live

# Optional other providers / partner credits
OPENROUTER_API_KEY=
